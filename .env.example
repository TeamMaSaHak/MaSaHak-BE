# ===========================================
# 마법사관학교 백엔드 환경변수 템플릿
# ===========================================

# 서버 설정
PORT=3000
NODE_ENV=development

# Supabase 설정
# Supabase 프로젝트 URL (예: https://xxxxx.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Supabase Service Role Key (서버 전용, 절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_KEY=your-service-role-key

# JWT 설정
# JWT 토큰 서명에 사용할 시크릿 키 (최소 32자 이상 권장)
JWT_SECRET=your-jwt-secret-key-min-32-characters
# Access Token 만료 시간 (예: 1h, 7d)
JWT_ACCESS_EXPIRES_IN=1h
# Refresh Token 만료 시간
JWT_REFRESH_EXPIRES_IN=7d

# Discord OAuth 설정
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
# 마법사관학교 디스코드 서버 ID
DISCORD_GUILD_ID=your-discord-guild-id

# Firebase Cloud Messaging (FCM) 설정
# Firebase 서비스 계정 JSON 파일 경로 또는 Base64 인코딩된 값
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# LLM 설정 (일기 답장용)
# Google Gemini API Key
GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# MCP 서버용 (개발 도구)
# ===========================================
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_DVS_PROJECT_REF=your-project-ref
